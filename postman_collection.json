    {
      "name": "Fertilizer & Water Calculators",
      "item": [
        {
          "name": "Calculate Fertilizer (N-P-K)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cropName\": \"Rice\",\n  \"soilType\": \"Alluvial\",\n  \"acreage\": 2.5\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/calculate/fertilizer",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "calculate", "fertilizer"]
            }
          }
        },
